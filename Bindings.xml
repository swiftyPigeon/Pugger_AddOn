<Bindings>
	<!-- The game's Key Bindings menu, AddOns: "Toggle the Pugger feed" (UI.lua names it). The game
	     loads this file from the add-on's folder by itself: it is not in the TOC. No key is bound
	     here; the player picks one. -->
	<Binding name="PUGGER_TOGGLE" header="PUGGER" category="ADDONS">
		Pugger_ToggleBinding()
	</Binding>
</Bindings>
